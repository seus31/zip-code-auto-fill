{
    "name": "seus31/zip-code-auto-fill",
    "description": "Livewireでzipcodeの自動入力を実装する。",
    "license": "MIT",
    "authors": [
        {
            "name": "SEUS31",
            "email": "develop@seusthreeone.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "livewire/livewire": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Seus31\\ZipCodeAutoFill\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Seus31\\ZipCodeAutoFill\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Seus31\\ZipCodeAutoFill\\Providers\\ZipCodeAutoFillServiceProvider"
            ]
        }
    }
}
